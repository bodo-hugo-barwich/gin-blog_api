---

# @author Bodo (Hugo) Barwich
# @version 2024-08-15
# @package Gin Blog
# @subpackage .env

# This is the Default Service Configuration
# This will be overwritten in different Deployment Environments
#

component: 'unknown'
project: 'Gin Blog'
description: 'Web Blog API with GoLang'
web_root: '/'
main_directory: ''
config_file: ''
port: 3000
admin:
  login: '<admin_login>'
  email: '<admin_email>'
  password: '<admin_password>'
database:
  driver: '<database_driver>'			# supported values: postgres | mysql
  host: '<database_host>'
  protocol: '<connection_protocol>'		# supported values: tcp | unix
  name: '<database_name>'
  user: '<database_user>'
  password: '<user_password>'
  params:								# any additional parameters for the connection
    <param_name>: '<param_value>'
